const PERMUTATION = 0;

const F_BITS = 31; // koala-bear = 31 bits
const DIM = 5; // extension degree

const N_VARS = N_VARS_PLACEHOLDER;
const LOG_INV_RATE = LOG_INV_RATE_PLACEHOLDER; 

const FOLDING_FACTOR_0 = FOLDING_FACTOR_0_PLACEHOLDER;

fn main() {
    whir_recursion((public_input_start / 8));
    return;
}

fn whir_recursion(transcript_start) {
    whir_round(FOLDING_FACTOR_0, 2**FOLDING_FACTOR_0);
    return;
}

fn sample_stir_indexes_and_fold(folding_factor, two_pow_folding_factor) {
    poly_eq_extension(folding_factor, two_pow_folding_factor);

    return;
}

fn whir_round(folding_factor, two_pow_folding_factor) {
    sample_stir_indexes_and_fold(folding_factor, two_pow_folding_factor);

    return;
}

fn powers(alpha, n) -> 1 {
    // alpha: EF
    // n: F

    res = malloc(n * DIM);
    set_to_one(res);
    for i in 0..n - 1 {
        mul_extension(res + i*DIM, alpha, res + (i + 1)*DIM);
    }
    return res;
}

fn poly_eq_extension(n, two_pow_n) {
    // Example: for n = 2: eq(x, y) = [(1 - x)(1 - y), (1 - x)y, x(1 - y), xy]

    if n == 0 {
        res = malloc(DIM);
        set_to_one(res);
        return;
    } else {
        res = malloc(two_pow_n * DIM); // deleting this makes the test pass

        poly_eq_extension(n - 1, two_pow_n / 2);

        return;
    }
}


fn pow(a, b) -> 1 {
    if b == 0 {
        return 1; // a^0 = 1
    } else {
        p = pow(a, b - 1);
        return a * p;
    }
}
fn mul_extension(a, b, c) inline {
    dot_product_ee(a, b, c, 1);
    return;
}

fn set_to_one(a) inline {
    a[0] = 1;
    a[1] = 0;
    return;
}

fn next_multiple_of_8(const a) -> 1 {
    return a + (8 - (a % 8)) % 8;
}

