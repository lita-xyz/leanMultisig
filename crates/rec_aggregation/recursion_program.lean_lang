const DIM = 2;

const N = 0;

fn main() {
    rec(N, 2**N);
    return;
}

fn rec(n, two_pow_n) {
    if n == 0 {
        res = malloc(2);
        res[1] = 0; // deleting this makes the test pass
        return;
    } else {
        res = malloc(two_pow_n * 2); // deleting this or any part of it makes the test pass

        return;
    }
}

