const DIM = 5;

const N = 7;

fn main() {
    rec(N, 2**N);
    return;
}

fn rec(n, two_pow_n) {
    if n == 0 {
        res = malloc(DIM);
        res[1] = 0; // deleting this makes the test pass
        return;
    } else {
        res = malloc(two_pow_n * DIM); // deleting this makes the test pass

        rec(n - 1, two_pow_n / 2); // deleting this makes the test pass

        return;
    }
}

